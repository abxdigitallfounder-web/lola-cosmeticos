# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Meta Conversions API token (Events Manager > Settings > Generate access token).
# Server side only: do not prefix with NEXT_PUBLIC_, or it ships to the browser.
META_CAPI_ACCESS_TOKEN=

# Jungle Pagamentos — API do seller (PIX). Server-side apenas.
JUNGLE_API_BASE=https://app.junglepagamentos.com/api
JUNGLE_API_KEY=
JUNGLE_WEBHOOK_SECRET=
JUNGLE_CALLBACK_URL=
